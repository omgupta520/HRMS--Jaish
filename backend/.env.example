# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/hrms

# ---- JWT ----
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Email (Nodemailer) ----
# For local dev you can leave these blank; emails are logged to console instead of sent.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HRMS <no-reply@hrms.local>"

# ---- Uploads ----
MAX_FILE_SIZE_MB=5
